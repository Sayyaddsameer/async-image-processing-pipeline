# ─────────────────────────────────────────────────────────────────
# Environment Variables
# Copy this file to .env before running:  cp .env.example .env
# Replace <your-id> with your unique identifier (e.g. GitHub username).
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── AWS Credentials ───────────────────────────────────────────────
# Use dummy values below for LocalStack — no real AWS account needed.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ── LocalStack Endpoint ───────────────────────────────────────────
# Inside Docker containers : http://localstack:4566
# From host machine (curl) : http://localhost:4566
AWS_ENDPOINT_URL=http://localstack:4566

# ── S3 Bucket Names ───────────────────────────────────────────────
# Must match the names created by the aws-init container.
S3_BUCKET_RAW=raw-images-<your-id>
S3_BUCKET_PROCESSED=processed-images-<your-id>

# ── SQS Resource Names (used by aws-init to create queues) ────────
SQS_MAIN_QUEUE=image-processing-queue-<your-id>
SQS_DLQ=image-processing-dlq-<your-id>

# ── SQS Queue URL (used by API and Worker at runtime) ─────────────
# LocalStack account ID is always 000000000000 for local development.
SQS_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/image-processing-queue-<your-id>

# ── API Settings ──────────────────────────────────────────────────
PRESIGNED_URL_EXPIRY_SECONDS=3600

# ── Worker Settings ───────────────────────────────────────────────
SQS_WAIT_TIME_SECONDS=20
SQS_MAX_MESSAGES=10
SQS_VISIBILITY_TIMEOUT=60
MAX_RETRIES=3
RETRY_BASE_DELAY=1.0
